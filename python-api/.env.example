DATABASE_URL=mysql+pymysql://root:123456@127.0.0.1:3306/order_ai

# EN: Groq LLM analysis. Without GROQ_API_KEY the API falls back to rules.
# 中文：Groq LLM 分析。未配置 GROQ_API_KEY 时接口自动使用规则分类。
# EN: Never commit a real key to this file. 中文：切勿把真实 Key 提交到此文件。
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=15
